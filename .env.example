# ===========================================
# JobKorea Crawler 환경설정 예제
# ===========================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.example .env
# 그 후 실제 값으로 수정하세요.

# -------------------------------------------
# 데이터베이스 설정
# -------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jobkorea
DB_USER=postgres
DB_PASSWORD=your_password_here

# -------------------------------------------
# 크롤링 설정
# -------------------------------------------
# 검색 키워드 (쉼표로 구분하여 다중 키워드 지원)
SEARCH_KEYWORDS=데이터분석가,사업기획,프로젝트매니저

# 단일 키워드 (하위 호환성용, SEARCH_KEYWORDS 사용 권장)
# SEARCH_KEYWORD=데이터분석가

# 검색 결과 카드에서 허용할 대표 지역명 (쉼표 구분, 비우면 전체 허용)
# 예: 서울,인천
SEARCH_LOCATIONS=

# 검색 결과 카드에서 허용할 경력 타입 (쉼표 구분)
# 지원 값: 신입, 경력, 신입·경력, 경력무관
SEARCH_EXPERIENCE_TYPES=

# hydration metadata 기준 허용할 고용형태 (쉼표 구분)
# 지원 값: 정규직, 계약직, 인턴
SEARCH_EMPLOYMENT_TYPES=

# 최대 크롤링 페이지 수 (1~100 권장)
MAX_PAGES=5

# 요청 간 딜레이 (초) - 봇 탐지 우회용
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# 브라우저 헤드리스 모드 (true: 화면 없음, false: 화면 표시)
HEADLESS=true

# 페이지 로딩 재시도 횟수
RETRY_ATTEMPTS=3

# 증분 크롤링 조기 종료 기준 (연속 기존 공고 수)
CONSECUTIVE_DUPLICATE_THRESHOLD=20

# 마지막 발견 시점 기준 stale 전환 일수
STALE_AFTER_DAYS=7

# -------------------------------------------
# 로깅 설정
# -------------------------------------------
# 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 로그 파일 디렉토리
LOG_DIR=log

# 참고:
# - 코드 기본 포트는 5433입니다.
# - 로컬 PostgreSQL이 5432를 쓰면 .env에서 DB_PORT=5432로 변경하세요.
